{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions install",
      "npm --prefix functions run build"
    ]
  },
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/experts/connect", "function": "expertsConnect" },
      { "source": "/api/payments/checkout", "function": "createCheckoutSession" },
      { "source": "/api/access/grant", "function": "grantAccessToken" },
      { "source": "/success", "destination": "/success.html" },
      { "source": "/cancel", "destination": "/cancel.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "predeploy": [
      "npm --prefix frontend install",
      "npm --prefix frontend run build"
    ]
  }
}
